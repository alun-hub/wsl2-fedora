# Definierar den "gyllene" Fedora-imagen som exporteras till en WSL2-rootfs-tarball.
# Byggs centralt (CI/build-maskin), inte per utvecklardator.
#
# Bygg:  podman build --build-arg FEDORA_VERSION=41 --build-arg DEV_USER=devuser \
#          -t fedora-golden:41 -f Containerfile.fedora-golden .
#
# OBS: Detta är en ren userland-rootfs för WSL2 - ingen kernel, ingen bootloader.
# WSL2 tillhandahaller kerneln, imagen behover bara innehalla Fedora-filsystemet.

ARG FEDORA_VERSION=44
FROM registry.fedoraproject.org/fedora:${FEDORA_VERSION}

ARG DEV_USER=devuser
ARG DEV_UID=1000

# --- Ombyggnadspolicy ---
# Denna image byggs om vid Fedora major-version-byten (t.ex. 41 -> 44),
# inte for varje sakerhetspatch. Lopande patchning mellan ombyggnader sker
# INUTI den korande distrot via dnf-automatic (installeras nedan), precis
# som pa teamets fysiska Fedora-arbetsstationer. Anvand
# upgrade-fedora-wsl.ps1 vid en major-version-uppgradering - den bevarar
# /home genom uppgraderingen.

# --- Baseline-paket ---
# Justera listan efter teamets standardverktyg. systemd behovs for att
# [boot] systemd=true i /etc/wsl.conf ska fungera. curl/unzip/tar/gzip/
# openssl ar byggblock som AWS-verktygen nedan behover.
RUN dnf -y update && \
    dnf -y install \
      sudo passwd systemd systemd-udev \
      git gh gcc gcc-c++ make cmake pkgconf-pkg-config \
      vim-enhanced tmux which findutils \
      curl unzip tar gzip openssl \
      python3-pip nodejs npm \
      dnf-automatic \
      podman \
    && dnf clean all && \
    systemctl enable dnf5-automatic.timer

# --- AWS/molnverktyg ---
# Dessa hamtas fran respektive leverantors "senaste version"-kanal vid
# byggtillfallet (GitHub releases / npm / pip), sa exakt version speglar
# nar imagen senast byggdes - inte ett pinnat versionsnummer i den har
# filen. Foljer samma ombyggnadspolicy som resten av imagen: uppdateras
# vid nasta ombyggnad, inte automatiskt i en redan utrullad distro.
# Utvecklare kan sjalva kora om install-kommandona nedan for att uppdatera
# ett enskilt verktyg i sin egen miljo mellan ombyggnader.

# Terraform (HashiCorp repo - finns inte i Fedoras egna repon pga licens)
RUN dnf -y install dnf-plugins-core && \
    dnf config-manager addrepo --from-repofile=https://rpm.releases.hashicorp.com/fedora/hashicorp.repo && \
    dnf -y install terraform && \
    dnf clean all

# AWS CLI v2 (officiell installer - finns inte som RPM)
RUN curl -fsSL "https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip" -o /tmp/awscliv2.zip && \
    unzip -q /tmp/awscliv2.zip -d /tmp && \
    /tmp/aws/install && \
    rm -rf /tmp/awscliv2.zip /tmp/aws

# kubectl (kubernetes.io:s officiella repo). OBS: v1.31 ar en specifik
# kanal - byt till den minor-version som matchar teamets EKS-kluster vid
# nasta ombyggnad.
RUN cat > /etc/yum.repos.d/kubernetes.repo <<'EOF'
[kubernetes]
name=Kubernetes
baseurl=https://pkgs.k8s.io/core:/stable:/v1.31/rpm/
enabled=1
gpgcheck=1
gpgkey=https://pkgs.k8s.io/core:/stable:/v1.31/rpm/repodata/repomd.xml.key
EOF
RUN dnf -y install kubectl && dnf clean all

# eksctl (EKS-kluster-CLI, officiell GitHub release-binar)
RUN curl -fsSL "https://github.com/eksctl-io/eksctl/releases/latest/download/eksctl_Linux_amd64.tar.gz" -o /tmp/eksctl.tar.gz && \
    tar -xzf /tmp/eksctl.tar.gz -C /usr/local/bin eksctl && \
    rm -f /tmp/eksctl.tar.gz

# helm (Kubernetes package manager, officiellt installscript)
RUN curl -fsSL https://raw.githubusercontent.com/helm/helm/main/scripts/get-helm-3 -o /tmp/get-helm.sh && \
    chmod +x /tmp/get-helm.sh && \
    /tmp/get-helm.sh && \
    rm -f /tmp/get-helm.sh

# AWS SAM CLI (serverless/Lambda, officiell installer)
RUN curl -fsSL "https://github.com/aws/aws-sam-cli/releases/latest/download/aws-sam-cli-linux-x86_64.zip" -o /tmp/samcli.zip && \
    unzip -q /tmp/samcli.zip -d /tmp/sam-installation && \
    /tmp/sam-installation/install && \
    rm -rf /tmp/samcli.zip /tmp/sam-installation

# AWS CDK (infrastructure-as-code i kod, via npm)
RUN npm install -g aws-cdk

# tflint (Terraform-linting)
RUN curl -fsSL "https://github.com/terraform-linters/tflint/releases/latest/download/tflint_linux_amd64.zip" -o /tmp/tflint.zip && \
    unzip -q /tmp/tflint.zip -d /usr/local/bin && \
    rm -f /tmp/tflint.zip

# tfsec (Terraform-sakerhetsskanning)
RUN curl -fsSL "https://github.com/aquasecurity/tfsec/releases/latest/download/tfsec-linux-amd64" -o /usr/local/bin/tfsec && \
    chmod +x /usr/local/bin/tfsec

# checkov + pre-commit (ytterligare IaC-sakerhetsskanning + git-hooks)
RUN pip install --root-user-action=ignore checkov pre-commit

# aws-vault (krypterad lokal lagring av AWS-nycklar/temporara sessioner,
# istallet for klartext i ~/.aws/credentials)
RUN curl -fsSL "https://github.com/99designs/aws-vault/releases/latest/download/aws-vault-linux-amd64" -o /usr/local/bin/aws-vault && \
    chmod +x /usr/local/bin/aws-vault

# --- Devanvandare med sudo (wheel, losenordslost for lokal utveckling) ---
RUN useradd -m -u ${DEV_UID} -G wheel -s /bin/bash ${DEV_USER} && \
    echo "%wheel ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/wheel-nopasswd && \
    chmod 0440 /etc/sudoers.d/wheel-nopasswd

# --- WSL-specifik konfiguration ---
# systemd=true ger en RIKTIG systemd/dbus-session (till skillnad fran
# podman-machine-defaults minimala bootstrap-wrapper) - ingen cgroup-manager-
# eller sd-bus-workaround behovs har.
#
# KAND PROBLEM (verifierat 2026-09-18): newuidmap/newgidmap forlorar sin
# setuid-bit nar de installeras under ett rootless `podman build` - RPM:ets
# %post-scriptlet som satter setuid-root lyckas inte i den kontexten. Utan
# setuid kan rootless podman inte skapa user-namespace-mappningar
# ("cannot set up namespace using newuidmap: should have setuid").
# Fix: samma monster som /run/user/1000-workarounden for podman-machine -
# ateranvand setuid-biten pa varje boot via [boot] command, oberoende av
# VARFOR den forsvann i grundavbildningen.
RUN { \
      echo '[boot]'; \
      echo 'systemd=true'; \
      echo 'command = "chmod u+s /usr/bin/newuidmap /usr/bin/newgidmap"'; \
      echo; \
      echo '[user]'; \
      echo "default=${DEV_USER}"; \
      echo; \
      echo '[network]'; \
      echo 'generateResolvConf = true'; \
    } > /etc/wsl.conf

# --- Enterprise-anpassning (fyll pa vid behov) ---
# Exempel: interna CA-cert for dnf/tls bakom foretagsproxy.
# COPY certs/corp-ca.crt /etc/pki/ca-trust/source/anchors/
# RUN update-ca-trust
#
# Exempel: internt dnf-repo istallet for/utover Fedoras officiella speglar.
# COPY dnf-repos/internal.repo /etc/yum.repos.d/internal.repo

# --- GUI-miljovariabler (WSLg) i devanvandarens shell ---
RUN { \
      echo 'export DISPLAY=:0'; \
      echo 'export WAYLAND_DISPLAY=wayland-0'; \
      echo 'export XDG_RUNTIME_DIR=/mnt/wslg/runtime-dir'; \
      echo 'export PULSE_SERVER=/mnt/wslg/PulseServer'; \
    } >> /home/${DEV_USER}/.bashrc

CMD ["/bin/bash"]
